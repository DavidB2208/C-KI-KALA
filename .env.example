# Local development only. Put generated values in .dev.vars (ignored by Git).
# Production values must be configured in Sites, never in the source archive.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CKK_APP_ORIGIN=http://localhost:5173
CKK_OWNER_EMAIL=owner@example.test
# SHA-256 hex of a separate, random, private activation code.
CKK_OWNER_SETUP_HASH=replace-with-sha256-of-private-activation-code
# Unix timestamp in milliseconds. The activation code expires at this time.
CKK_OWNER_SETUP_EXPIRES=0
# Optional: exact legacy profile ID to preserve during owner activation.
CKK_OWNER_LEGACY_PROFILE_ID=

# Stripe: closed by default. Use a separate test environment first.
CKK_BILLING_MODE=off
CKK_BILLING_READY=0
CKK_CHECKOUT_OPEN=0
STRIPE_SECRET_KEY=
# Prefer a restricted rk_test_/rk_live_ server key with only the API permissions this app needs.
# The legacy variable name also accepts sk_test_/sk_live_; keep either value out of Git.
STRIPE_WEBHOOK_SECRET=
CKK_LEGAL_NAME=
CKK_SUPPORT_EMAIL=
CKK_TERMS_URL=
